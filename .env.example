# Server
PORT=3000
NODE_ENV=development

# MongoDB - use local MongoDB or MongoDB Atlas connection string
# Local example: mongodb://127.0.0.1:27017/comp3123_assignment1
# Atlas example: mongodb+srv://<username>:<password>@cluster.mongodb.net/comp3123_assignment1
MONGODB_URI=mongodb://127.0.0.1:27017/comp3123_assignment1

# JWT - use a long random secret in production (never commit real secrets)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_min_32_chars
JWT_EXPIRES_IN=1h

# Rate limiting (optional overrides)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=100
# AUTH_RATE_LIMIT_MAX=10
